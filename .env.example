# Hamilton — environment configuration
# Copy to .env.local for local dev (never commit .env)

# MQTT broker (Mosquitto in docker compose)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_BROKER_WS_URL=ws://localhost:9001

# LLM providers (Phase 8 — togglable)
# Anthropic Claude (primary). Leave blank to disable Claude provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Local Llama via Ollama (fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Trust engine
TRUST_ENGINE_HTTP_PORT=8080
TRUST_ENGINE_DB_PATH=./data/trust.duckdb
# FR-03 spatial correlation: neighbours within this radius (metres) of a
# degrading source decide localized (all healthy) vs blanket (any degrading).
TRUST_ENGINE_SPATIAL_RADIUS_M=500

# Comms simulator
COMMS_SIM_SCENARIO=avdiivka
COMMS_SIM_SPEED=1
COMMS_SIM_SEED=42

# Renderer (cesium | maplibre — fallback per System Design §6c)
NEXT_PUBLIC_RENDERER=cesium

# TSS thresholds are configuration data, not an env constant: the versioned
# DEFAULT_TSS_TABLE in apps/web/src/lib/tss.ts (GPS-guided C = score ≥ 0.60).
# NEXT_PUBLIC_ROE_FLOOR is no longer read (docs/plans/tss-mission-row.md).

# Trust-engine HTTP API, proxied same-origin by apps/web/app/engine/api
ENGINE_HTTP_URL=http://localhost:8080

# Basemap (System Design §6c "Basemap"; apps/web/src/lib/basemap.ts)
#   offline — self-hosted Protomaps vector extract (MapLibre) + locally rendered
#             raster pyramid (Cesium) from apps/web/public/tiles. NFR-01.
#             Provision once, online: `make fetch-tiles`.
#   online  — DEV ONLY: OSM raster tiles from tile.openstreetmap.org, dimmed.
#             NOT NFR-01 compliant; opens that origin in the CSP.
#   none    — no basemap; symbols on --surface-base.
# Leave empty for the default: offline if the tiles are provisioned, else none.
NEXT_PUBLIC_BASEMAP=

